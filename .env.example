# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# ElevenLabs reel TTS with timestamps. Server-only; do not prefix with NEXT_PUBLIC_.
# Voice/model are configured in reel_story_settings (defaults: EXAVITQu4vr4xnSDxMaL / eleven_multilingual_v2).
ELEVENLABS_API_KEY=""

# Alternate image and text providers. Each key gates its rows in image_model_registry /
# text_model_registry: a model stays unavailable until every var in its required_env_vars
# is set. Server-only.
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
XAI_API_KEY=""
# Runware fronts open-weight image models (FLUX.2, Seedream, Qwen) on one endpoint.
RUNWARE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CRON_SECRET: Shared bearer token authorising the background worker routes
# (/api/batch/*, /api/media/jobs/run, /api/reference/jobs/run). Any long random
# string, but it must match the value Vercel Cron sends. Server-only.
CRON_SECRET=""

# Supabase: Required for auth and data persistence.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
ADMIN_USER_ID=""
SUPPORT_EMAIL=""

# AGENTIC_SYSTEM_USER_ID: the Supabase auth user id that owns every story the
# Agentic Creator system generates (see docs/agentic-creator-*.md). Also the
# only account lib/pricing/enforcement.ts will ever let skip the coin
# reservation, and only when agentic_billing_bypass_enabled is also on. The
# feature stays inert while this is unset -- there is no default. Server-only.
AGENTIC_SYSTEM_USER_ID=""

# Legal consent gate (proxy.ts + lib/legal/). Optional: signs the
# kissago_legal_ok cookie so a compliant user skips a DB read on every
# request. Unset simply disables that fast path -- proxy.ts always falls
# back to a live check, so this is never required for correctness, only
# for avoiding an extra query per request. Any long random string.
LEGAL_CONSENT_COOKIE_SECRET=""

# Cloudflare R2 staging media storage. Do not expose access keys with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kissago-media-staging"
R2_PRIVATE_BUCKET_NAME="kissago-media-private-staging"
R2_PUBLIC_BASE_URL="https://media-stage.kissago.cc"
R2_ENDPOINT="https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ENABLED="true"
R2_STORAGE_MODE="hybrid"
R2_ENVIRONMENT="staging"
R2_PRODUCTION_ENABLED="false"
R2_PUBLIC_DELIVERY_ENABLED="true"
R2_CACHE_CONTROL_PUBLIC="public, max-age=31536000, immutable"
R2_CACHE_CONTROL_PRIVATE="private, max-age=3600"

# Razorpay: Required for India checkout integration.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Client-side image compression before upload. Optional — lib/constants/media.ts
# falls back to these same values (960 x 540, quality 0.65) when unset.
NEXT_PUBLIC_IMAGE_MAX_WIDTH="960"
NEXT_PUBLIC_IMAGE_MAX_HEIGHT="540"
NEXT_PUBLIC_IMAGE_QUALITY="0.65"

# Playwright admin e2e (optional). e2e/agentic-admin.spec.ts signs in through the
# normal AuthDialog to prove the /admin surfaces render for a real admin session.
# Without both values that spec SKIPS rather than fails, so machines with no admin
# account stay green -- which also means a typo here is silent. The account must be
# the one whose id equals ADMIN_USER_ID: verifyAdmin() is a single id comparison,
# not a role lookup, so a purpose-made e2e user authenticates and is then rejected
# on every admin route. playwright.config.ts loads this file itself (Next does not
# do it for the test runner, and dotenv is not a dependency).
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
