{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "//header-size": "dev/preview raise Node's 16KB request-header cap. On localhost every project shares one cookie origin and Supabase stores auth tokens as several large chunked cookies, so that ceiling is reachable and Node answers HTTP 431 before Next sees the request. Left off `start`: standalone output prunes node_modules, so the explicit bin path is not safe for a hosted entrypoint.",
    "dev": "node --max-http-header-size=32768 node_modules/next/dist/bin/next dev",
    "//agent-server": "Agent-owned dev server: its own port (3100) and its own build directory (.next-agent), so it can never collide with `npm run dev` on 3000/.next. start is idempotent and waits until the server actually answers; stop kills the whole tree, because killing the wrapper alone orphans the child.",
    "dev:agent": "node scripts/agent-dev.mjs start",
    "dev:agent:stop": "node scripts/agent-dev.mjs stop",
    "dev:agent:status": "node scripts/agent-dev.mjs status",
    "dev:agent:logs": "node scripts/agent-dev.mjs logs",
    "build": "next build",
    "build:verify": "node scripts/agent-build.mjs",
    "preview": "node --max-http-header-size=32768 node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000",
    "start": "next start",
    "test": "vitest run",
    "test:character-novelty-smoke": "vitest run --config vitest.smoke.config.ts",
    "//e2e": "Browser smoke tests (Playwright, chromium). test:e2e starts the agent dev server on 3100 first \u2014 it is idempotent, so it reuses one that is already running. Run `npx playwright install chromium` once per machine.",
    "test:e2e": "node scripts/agent-dev.mjs start && playwright test",
    "test:e2e:headed": "node scripts/agent-dev.mjs start && playwright test --headed",
    "test:e2e:ui": "node scripts/agent-dev.mjs start && playwright test --ui",
    "compare:image-prompts": "vitest run lib/ai/prompt-compiler/compare.shared.test.ts",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^2.12.0",
    "@hookform/resolvers": "^5.2.1",
    "@mediabunny/aac-encoder": "^1.45.4",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "mediabunny": "^1.45.4",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
