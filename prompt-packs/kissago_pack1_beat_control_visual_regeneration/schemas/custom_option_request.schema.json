{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomOptionRequest",
  "type": "object",
  "required": [
    "storyId",
    "beatId",
    "optionText"
  ],
  "properties": {
    "storyId": {
      "type": "string"
    },
    "beatId": {
      "type": "string"
    },
    "optionText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "characterMentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "displayText",
          "characterName"
        ],
        "properties": {
          "displayText": {
            "type": "string"
          },
          "characterName": {
            "type": "string"
          },
          "characterId": {
            "type": "string"
          },
          "startIndex": {
            "type": "integer"
          },
          "endIndex": {
            "type": "integer"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
