{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://kissago.cc",
          "https://www.kissago.cc",
          "http://localhost:3000"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["*"]
